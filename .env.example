AUTH_DB_HOST=localhost
AUTH_DB_PORT=5432
AUTH_DB_USER=admin
AUTH_DB_PASSWORD=llmobs_s3cret_2026
AUTH_DB_NAME=llm_observability
DATABASE_URL=postgresql://admin:llmobs_s3cret_2026@localhost:5432/llm_observability

AUTH_REDIS_HOST=localhost
AUTH_REDIS_PORT=6379
AUTH_REDIS_PASSWORD=llmobs_redis_s3cret_2026
REDIS_URL=redis://:llmobs_redis_s3cret_2026@localhost:6379/0

KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=auth-client
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

OTEL_EXPORTER_OTLP_ENDPOINT=https://localhost:4318
OTEL_EXPORTER_OTLP_GRPC_ENDPOINT=localhost:4317
OTEL_SERVICE_NAME=auth-service
OTEL_EXPORTER_OTLP_INSECURE=true

SERVICE_REGISTRY_URL=http://localhost:31426

# Mailer Configuration (provider: mock | smtp | ses | sendgrid)
MAILER_PROVIDER=mock
MAILER_FROM=noreply@auth.local
APP_URL=http://localhost:3000

# SMTP (when MAILER_PROVIDER=smtp)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_SECURE=false

# AWS SES (when MAILER_PROVIDER=ses)
# AWS_SES_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# Breached Password Screening (NIST SP 800-63B / HIBP Range API)
AUTH_BREACHED_PASSWORD_ENABLED=true
AUTH_BREACHED_PASSWORD_BASE_URL=https://api.pwnedpasswords.com/range
AUTH_BREACHED_PASSWORD_TIMEOUT_MS=1500
AUTH_BREACHED_PASSWORD_USER_AGENT=llm-observability-auth/1.0.0

# Automated Security Headers & Strict CSP (W3C CSP Level 3 / RFC 6797 HSTS)
AUTH_SECURITY_HEADERS_ENABLED=true
AUTH_SECURITY_HEADERS_HSTS_ENABLED=true
AUTH_SECURITY_HEADERS_HSTS_MAX_AGE=63072000
AUTH_SECURITY_HEADERS_HSTS_INCLUDE_SUBDOMAINS=true
AUTH_SECURITY_HEADERS_HSTS_PRELOAD=true
AUTH_SECURITY_HEADERS_FRAME_OPTIONS=DENY
AUTH_SECURITY_HEADERS_NOSNIFF=true
AUTH_SECURITY_HEADERS_REFERRER_POLICY=strict-origin-when-cross-origin
AUTH_SECURITY_HEADERS_PERMISSIONS_POLICY="geolocation=(), camera=(), microphone=(), payment=()"
AUTH_SECURITY_HEADERS_CSP_ENABLED=true
AUTH_SECURITY_HEADERS_CSP_REPORT_ONLY=false
AUTH_SECURITY_HEADERS_COOP=same-origin
AUTH_SECURITY_HEADERS_CORP=same-origin

# OAuth SSO Configuration (Google & GitHub)
AUTH_OAUTH_GOOGLE_CLIENT_ID=
AUTH_OAUTH_GOOGLE_CLIENT_SECRET=
AUTH_OAUTH_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google
AUTH_OAUTH_GITHUB_CLIENT_ID=
AUTH_OAUTH_GITHUB_CLIENT_SECRET=
AUTH_OAUTH_GITHUB_REDIRECT_URI=http://localhost:3000/auth/callback/github

# Multi-Factor Authentication (RFC 6238 TOTP)
AUTH_MFA_ISSUER=LLMObservability
AUTH_MFA_STEP_WINDOW=1

# OpenID Connect (OIDC) Identity Provider & Discovery Core (RFC 8414 / RFC 7636)
AUTH_OIDC_ISSUER=http://localhost:3001
AUTH_OIDC_CODE_TTL_MS=300000
AUTH_OIDC_TOKEN_TTL_SECONDS=3600

# SAML 2.0 Enterprise Identity Provider & SP Federation (ADR 0026)
AUTH_SAML_SP_ENTITY_ID=http://localhost:3001/api/v1/auth/saml/metadata
AUTH_SAML_ACS_URL=http://localhost:3001/api/v1/auth/saml/acs
AUTH_SAML_CLOCK_SKEW_MS=120000
AUTH_SAML_RELAY_STATE_TTL_MS=300000

# Adaptive Risk-Based Authentication & GeoIP Resolver

AUTH_GEOIP_PROVIDER=mock
AUTH_GEOIP_HTTP_ENDPOINT=https://ipwho.is
AUTH_GEOIP_TIMEOUT_MS=1500
AUTH_GEOIP_DB_PATH=

# NIST SP 800-63B Password History Retention (ADR 0028)
AUTH_PASSWORD_HISTORY_LIMIT=10

# Mock Services Flags
USE_MOCK_REDIS=false
USE_MOCK_DB=false
